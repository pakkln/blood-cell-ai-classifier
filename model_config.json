{
  "model_name": "bloodmnist_cnn",
  "dataset": "BloodMNIST",
  "input_shape": [
    3,
    28,
    28
  ],
  "num_classes": 8,
  "preprocessing": "ToTensor",
  "class_mapping": {
    "0": "basophil",
    "1": "eosinophil",
    "2": "erythroblast",
    "3": "immature granulocytes(myelocytes, metamyelocytes and promyelocytes)",
    "4": "lymphocyte",
    "5": "monocyte",
    "6": "neutrophil",
    "7": "platelet"
  },
  "checkpoint": "models/bloodmnist_cnn_10epochs.pth"
}